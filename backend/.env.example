# Everything here is optional - the app runs with no .env at all.

# Port for the web app + API (open http://localhost:8000)
PORT=8000

# Database. Default is a SQLite file next to the backend (zero setup).
# Any SQLAlchemy URL works, e.g. postgresql+psycopg://user:pass@localhost/college
# DATABASE_URL=sqlite:///./college_timetable.db

# Secret used to sign login tokens. If unset, a random one is generated on first
# run and saved to backend/.secret_key
# TOKEN_SECRET=

# How long a login lasts
TOKEN_HOURS=12
